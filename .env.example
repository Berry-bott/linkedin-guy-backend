# ---------------------------------------------------------------------------
# Database (Neon Postgres)
# ---------------------------------------------------------------------------
# Get this from the Neon console: Project -> Connect -> Connection string.
# IMPORTANT: use the *pooled* connection string (host contains "-pooler") for
# the app, and the *direct* string for migrations. See README.md.
#
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Optional: direct (non-pooled) URL used only by `prisma migrate` / `prisma db push`.
# If omitted, DATABASE_URL is used for migrations too.
# DIRECT_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="replace-me-with-a-long-random-string"
JWT_EXPIRES_IN="7d"

# ---------------------------------------------------------------------------
# Email verification (SMTP, delivered with nodemailer)
# ---------------------------------------------------------------------------
# Registration emails a single-use 6-digit code; login is blocked until
# POST /api/auth/verify-email confirms it. SMTP_HOST is required in
# production — without it the app refuses to boot.
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
# Force the IP version for the SMTP socket. Keep 4 on hosts without IPv6 routing
# (Render, some CI) — they resolve Gmail to an AAAA record and fail ENETUNREACH.
# Use 6 for IPv6-only hosts, or 0 to let the OS decide.
SMTP_FAMILY=4
# "true" for implicit TLS on port 465; "false" keeps STARTTLS on 587.
SMTP_SECURE=false
SMTP_USER="no-reply@example.com"
SMTP_PASS="replace-with-smtp-password"
SMTP_FROM="chuks-kitchen <no-reply@example.com>"

# Base URL used when building links inside emails.
APP_URL="http://localhost:5000"
# How long a verification code stays valid, and how many wrong attempts are
# allowed before a new code must be requested.
EMAIL_VERIFICATION_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# Comma-separated list of allowed browser origins (CORS).
# The frontend is deployed at https://chuks-kitchen-seven.vercel.app
CORS_ORIGIN="http://localhost:3000,https://chuks-kitchen-seven.vercel.app"

# Set to "true" to also allow every *.vercel.app preview deployment.
CORS_ALLOW_VERCEL_PREVIEWS=true

# Local development aid: when SMTP is not configured, log the verification code
# to the server console instead of failing. NEVER set this in production.
# EMAIL_LOG_VERIFICATION_CODE=true
